# Copy this file to .env for a one-time local migration.
# Do not commit .env. Paste the service role key only in .env and in Render.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Leave these unset on the live site. The test site sets them in Render.
# APP_ENV=test
# EMAILS_ENABLED=false
# SCHEDULED_ACTIONS_ENABLED=false
# FEATURE_NEW_FUNCTION=false
